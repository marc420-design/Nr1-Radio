# ─── AzuraCast ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AZURACAST_BASE_URL=https://your-azuracast-host.com
NEXT_PUBLIC_STATION_ID=your_station_shortcode
NEXT_PUBLIC_STATION_SHORTCODE=your_station_shortcode
AZURACAST_API_KEY=your-admin-api-key   # optional — enables listener geo-stats

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id

# ─── Site URL (used for embed snippets etc.) ──────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://listen-nr1dnb.com

# ─── Web push (live show alerts) ──────────────────────────────────────────────
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional. If set, the AzuraCast live webhook requires this in X-Webhook-Secret.
# The route verifies live state against AzuraCast regardless, so it is optional.
PUSH_WEBHOOK_SECRET=

# ─── Supabase (server only) ───────────────────────────────────────────────────
# Used by getSupabaseAdminClient to bypass RLS. Was already required by the
# admin routes but missing from this file.
SUPABASE_SERVICE_ROLE_KEY=
